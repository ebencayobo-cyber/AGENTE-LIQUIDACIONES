      "parameters": {
        "jsCode": "\n// Prepara variables. Trunca el error porque los params de plantilla no admiten saltos de línea.\nconst j = $input.item.json || {};\nconst workflow = (j.workflow && j.workflow.name) || 'desconocido';\nconst nodo = (j.execution && j.execution.lastNodeExecuted) || 'desconocido';\nlet err = (j.execution && j.execution.error && j.execution.error.message) ? j.execution.error.message : 'sin detalle';\nerr = String(err).replace(/\\s+/g, ' ').trim().slice(0, 250);\nconst hora = $now.toFormat('dd/MM/yyyy HH:mm');\nconst execId = (j.execution && j.execution.id) ? String(j.execution.id) : 's/id';\nreturn [{ json: { workflow, nodo, err, hora, execId } }];\n"
